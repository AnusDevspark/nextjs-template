# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Values are validated by src/config/env.ts
# (browser-safe) and src/config/server-env.ts (server-only) on boot — a missing
# or malformed value fails fast with a readable message instead of an
# undefined-at-runtime bug.
# ---------------------------------------------------------------------------

# --- Browser-safe (inlined into the client bundle — never put secrets here) ---

NEXT_PUBLIC_APP_NAME="Acme Admin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL of your Node.js REST API, including any version prefix.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# direct | proxy
#   direct — browser calls NEXT_PUBLIC_API_URL straight. Requires CORS on the
#            API: Access-Control-Allow-Origin: <NEXT_PUBLIC_APP_URL> and
#            Access-Control-Allow-Credentials: true.
#   proxy  — browser calls /api/bff/* on this app, which forwards server-side.
#            Use when CORS is not an option. Also set API_PROXY_ENABLED=true.
NEXT_PUBLIC_API_MODE="direct"

# Optional. Leave blank to disable error reporting.
NEXT_PUBLIC_SENTRY_DSN=""

# --- Server-only (never sent to the browser) ---

# Usually the same as NEXT_PUBLIC_API_URL, but may be an internal hostname
# (e.g. http://api.internal:4000/api/v1) that the browser cannot reach.
API_URL="http://localhost:4000/api/v1"

API_TIMEOUT_MS="15000"

# Must be "true" for /api/bff/* to forward anything. Keep "false" in direct mode.
API_PROXY_ENABLED="false"

# Cookie names. Change if you run several apps on one domain.
AUTH_ACCESS_COOKIE="acme_at"
AUTH_REFRESH_COOKIE="acme_rt"

# Refresh cookie lifetime in seconds (default 30 days).
AUTH_REFRESH_MAX_AGE="2592000"
